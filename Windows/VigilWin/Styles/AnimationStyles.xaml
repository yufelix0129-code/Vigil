<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut" />
    <CubicEase x:Key="EaseInCubic" EasingMode="EaseIn" />
    <CubicEase x:Key="EaseInOutCubic" EasingMode="EaseInOut" />
    <QuinticEase x:Key="EaseOutQuint" EasingMode="EaseOut" />
    <QuinticEase x:Key="EaseInOutQuint" EasingMode="EaseInOut" />
</ResourceDictionary>
