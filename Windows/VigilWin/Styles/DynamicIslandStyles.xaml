<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="IslandBackgroundBrush" Color="#F0181A20" />
    <SolidColorBrush x:Key="IslandBorderBrush" Color="#32FFFFFF" />
    <SolidColorBrush x:Key="IslandHighlightBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="IslandProgressTrackBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="IslandTextPrimaryBrush" Color="#F7F8FC" />
    <SolidColorBrush x:Key="IslandTextSecondaryBrush" Color="#AEB6C6" />

    <Style x:Key="IslandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="IslandGhostButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextSecondaryBrush}" />
        <Setter Property="Background" Value="#16FFFFFF" />
        <Setter Property="BorderBrush" Value="#24FFFFFF" />
    </Style>
</ResourceDictionary>
