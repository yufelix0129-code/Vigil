<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundStart">#F7F8FC</Color>
    <Color x:Key="AppBackgroundEnd">#F3F1FF</Color>
    <Color x:Key="GlassCardBackground">#F2FFFFFF</Color>
    <Color x:Key="GlassCardBorder">#F7FFFFFF</Color>
    <Color x:Key="TextPrimary">#1F2430</Color>
    <Color x:Key="TextSecondary">#687386</Color>
    <Color x:Key="AccentPrimary">#6C63FF</Color>
    <Color x:Key="AccentSecondary">#7C6DFF</Color>
    <Color x:Key="FocusedColor">#35D3AE</Color>
    <Color x:Key="WanderingColor">#F5B842</Color>
    <Color x:Key="DistractedColor">#FF6857</Color>
    <Color x:Key="IdleColor">#8B93A3</Color>
    <Color x:Key="UnknownColor">#8B93A3</Color>
    <Color x:Key="IslandBackground">#181A20</Color>
    <Color x:Key="IslandTextPrimary">#F7F8FC</Color>
    <Color x:Key="IslandTextSecondary">#AEB6C6</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#6D6AF2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7D7AFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#ECEBFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F8FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F6F7FB" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#DDE2EA" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#607086" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A96A8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#23A982" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF6262" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondary}" />
    <SolidColorBrush x:Key="FocusedBrush" Color="{StaticResource FocusedColor}" />
    <SolidColorBrush x:Key="WanderingBrush" Color="{StaticResource WanderingColor}" />
    <SolidColorBrush x:Key="DistractedBrush" Color="{StaticResource DistractedColor}" />
    <SolidColorBrush x:Key="IdleBrush" Color="{StaticResource IdleColor}" />
    <SolidColorBrush x:Key="UnknownBrush" Color="{StaticResource UnknownColor}" />

    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="32"
                      Direction="270"
                      Opacity="0.10"
                      ShadowDepth="12"
                      Color="#556070" />

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="28" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="GlassCard"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}" />

    <Style x:Key="SettingsSectionCard"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}" />

    <Style x:Key="HistoryItemCard" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="#F7F9FD" />
        <Setter Property="BorderBrush" Value="#E5EAF2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="InnerMetricCard" TargetType="Border">
        <Setter Property="MinHeight" Value="122" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="#F6F8FC" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="19" />
    </Style>

    <Style x:Key="AppTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="36" />
    </Style>

    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource AppTitleText}">
        <Setter Property="FontSize" Value="30" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleTextStyle}" />

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="MetricNumberText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="34" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#FBFCFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="13">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernTextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBoxStyle}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#FBFCFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="13">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernPasswordBox"
           TargetType="PasswordBox"
           BasedOn="{StaticResource RoundedPasswordBoxStyle}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#F0F3F8" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#E7ECF5" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#D4DAE5" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="GhostButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="GhostButton"
           TargetType="Button"
           BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="IconButton"
           TargetType="Button"
           BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="CleanComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#FBFCFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" />
                        <Path Width="10"
                              Height="6"
                              Margin="0,0,16,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Data="M 0 0 L 5 5 L 10 0"
                              Stroke="{StaticResource TextMutedBrush}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.8" />
                        <ToggleButton Background="Transparent"
                                      BorderThickness="0"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,6,0,0"
                                    Padding="6"
                                    Background="#FFFFFFFF"
                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      Direction="270"
                                                      Opacity="0.16"
                                                      ShadowDepth="8"
                                                      Color="#556070" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="220">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#CBD3E0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource CleanComboBoxStyle}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="ModernCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="20"
                                Height="20"
                                Margin="0,0,10,0"
                                Background="#FBFCFF"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Path x:Name="CheckMark"
                                  Width="10"
                                  Height="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1 4 L 4 7 L 9 1"
                                  Opacity="0"
                                  Stroke="White"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome"
                            Background="Transparent"
                            CornerRadius="10">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="#F0F3F8" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
