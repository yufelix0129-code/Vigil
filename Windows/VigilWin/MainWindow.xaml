<Window x:Class="VigilWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vigil for Windows"
        Width="1160"
        Height="800"
        MinWidth="980"
        MinHeight="700"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7F8FC" Offset="0" />
            <GradientStop Color="#EEF2F8" Offset="0.55" />
            <GradientStop Color="#F6F3FF" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Border x:Name="MainShell"
                    Padding="38"
                    Background="#F2FFFFFF"
                    BorderBrush="#F7FFFFFF"
                    BorderThickness="1"
                    CornerRadius="32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36"
                                      Direction="270"
                                      Opacity="0.13"
                                      ShadowDepth="12"
                                      Color="#687083" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,28">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,10,0"
                                    Style="{StaticResource PillButtonStyle}"
                                    Click="SettingsButton_Click"
                                    Content="Settings" />
                            <Button Style="{StaticResource PillButtonStyle}"
                                    Click="HistoryButton_Click"
                                    Content="History" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Style="{StaticResource AppTitleText}"
                                       Text="Vigil" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="AI-powered focus monitor for Windows" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1"
                          MinHeight="470">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="0.92*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="FocusSetupCard"
                                Grid.Column="0"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Style="{StaticResource SectionTitleTextStyle}"
                                           Text="Start a focus session" />
                                <TextBlock Grid.Row="1"
                                           Margin="0,7,0,24"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Tell Vigil what you are working on. It will quietly monitor your focus and nudge you back when needed." />

                                <TextBlock Grid.Row="2"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="Focus goal" />
                                <Grid Grid.Row="3"
                                      Margin="0,0,0,22">
                                    <TextBox x:Name="FocusGoalTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             TextChanged="FocusGoalTextBox_TextChanged" />
                                    <TextBlock x:Name="FocusGoalPlaceholder"
                                               Margin="14,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               IsHitTestVisible="False"
                                               Text="What do you want to focus on? e.g., review chemistry equations"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <TextBlock Grid.Row="4"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="Session length" />
                                <ComboBox x:Name="DurationComboBox"
                                          Grid.Row="5"
                                          Margin="0,0,0,0"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectedIndex="1">
                                    <ComboBoxItem Content="15 分钟" />
                                    <ComboBoxItem Content="25 分钟" />
                                    <ComboBoxItem Content="45 分钟" />
                                    <ComboBoxItem Content="60 分钟" />
                                </ComboBox>

                                <Grid Grid.Row="7"
                                      Margin="0,28,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="StartFocusButton_Click"
                                            Content="Start Focus" />

                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="StopFocusButton_Click"
                                            Content="Stop Focus" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="LiveStatusCard"
                                Grid.Column="2"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Style="{StaticResource SectionTitleTextStyle}"
                                           Text="Live Status" />

                                <Border Grid.Row="1"
                                        Margin="0,22,0,0"
                                        Padding="14,11"
                                        Background="#F2F5FA"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <DockPanel>
                                        <Ellipse x:Name="StatusDot"
                                                 Width="12"
                                                 Height="12"
                                                 Margin="0,0,10,0"
                                                 Fill="#A6AFBD"
                                                 DockPanel.Dock="Left" />
                                        <TextBlock x:Name="CurrentStatusText"
                                                   VerticalAlignment="Center"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="Not started" />
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="2"
                                      Margin="0,24,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource InnerMetricCard}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="Focused time" />
                                            <TextBlock x:Name="ElapsedTimeText"
                                                       Style="{StaticResource MetricNumberText}"
                                                       Margin="0,9,0,0"
                                                       Text="00:00" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource InnerMetricCard}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="Distractions" />
                                            <TextBlock x:Name="DistractionCountText"
                                                       Style="{StaticResource MetricNumberText}"
                                                       Margin="0,9,0,0"
                                                       Text="0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="3"
                                        MinHeight="128"
                                        Padding="18"
                                        Background="#F7F8FC"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="Latest AI reason" />
                                        <TextBlock x:Name="LatestReasonText"
                                                   Grid.Row="1"
                                                   Margin="0,9,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="Waiting for the first analysis..."
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="2"
                               LastChildFill="False"
                               Margin="0,24,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Data is stored locally on this device." />

                        <Button Width="148"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}"
                                Click="TestScreenshotButton_Click"
                                Content="Test Screenshot" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
