<Window x:Class="VigilWin.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Opacity="0"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="Maximized"
        WindowStyle="None">
    <Grid x:Name="OverlayRoot"
          Background="#990B1020">
        <Border x:Name="OverlayCard"
                Width="580"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F2FFFFFF"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                CornerRadius="30"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.96"
                                ScaleY="0.96" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="42"
                                  Direction="270"
                                  Opacity="0.30"
                                  ShadowDepth="18"
                                  Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Back to your goal" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Text="A quick reset. No lock-in, just a gentle nudge." />

                <Border Margin="0,26,0,16"
                        Padding="18"
                        Background="#F6F8FC"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="20">
                    <TextBlock x:Name="GoalText"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="ReasonText"
                           Margin="0,0,0,30"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Button Width="136"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PrimaryButton}"
                        Click="CloseButton_Click"
                        Content="I'm back" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
