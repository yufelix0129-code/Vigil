<Window x:Class="VigilWin.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="#AA111827"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="Maximized"
        WindowStyle="None">
    <Grid>
        <Border Width="520"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F9FAFB"
                CornerRadius="12">
            <StackPanel>
                <TextBlock Margin="0,0,0,14"
                           HorizontalAlignment="Center"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Text="Back to your goal" />

                <TextBlock x:Name="GoalText"
                           Margin="0,0,0,10"
                           FontSize="16"
                           Foreground="#1F2937"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="ReasonText"
                           Margin="0,0,0,24"
                           FontSize="14"
                           Foreground="#4B5563"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Button Width="120"
                        Height="38"
                        HorizontalAlignment="Center"
                        Background="#2563EB"
                        BorderBrush="#2563EB"
                        Click="CloseButton_Click"
                        Content="我知道了"
                        Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
