<Window x:Class="VigilWin.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="#B8000000"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="Maximized"
        WindowStyle="None">
    <Grid>
        <Border Width="560"
                Padding="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F4FFFFFF"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="26">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36"
                                  Direction="270"
                                  Opacity="0.28"
                                  ShadowDepth="16"
                                  Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Back to your goal" />

                <Border Margin="0,24,0,14"
                        Padding="18"
                        Background="#F5F7FB"
                        CornerRadius="18">
                    <TextBlock x:Name="GoalText"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="ReasonText"
                           Margin="0,0,0,28"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Button Width="132"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CloseButton_Click"
                        Content="I'm back" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
