<Window x:Class="VigilWin.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        Width="960"
        Height="620"
        MinWidth="820"
        MinHeight="520"
        Background="#F4F6F8"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="16"
                Background="White"
                BorderBrush="#DDE2E7"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel>
                <TextBlock Margin="0,0,0,12"
                           DockPanel.Dock="Top"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="最近 20 次专注记录" />
                <ListBox x:Name="SessionListBox"
                         SelectionChanged="SessionListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,8">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Goal}"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="#6B7280"
                                           Text="{Binding StartTime, StringFormat=开始：{0:g}}" />
                                <TextBlock Foreground="#6B7280"
                                           Text="{Binding DistractionCount, StringFormat=分心次数：{0}}" />
                                <TextBlock Foreground="#6B7280"
                                           MaxHeight="38"
                                           Text="{Binding Summary}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2"
                Padding="18"
                Background="White"
                BorderBrush="#DDE2E7"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel>
                <TextBlock Margin="0,0,0,12"
                           DockPanel.Dock="Top"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="详情" />

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="DetailGoalText"
                               Margin="0,0,0,8"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="请选择一条记录" />
                    <TextBlock x:Name="DetailStatsText"
                               Margin="0,0,0,8"
                               Foreground="#374151"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailSummaryText"
                               Margin="0,0,0,14"
                               Foreground="#4B5563"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListView x:Name="FrameRecordsListView">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="130"
                                            DisplayMemberBinding="{Binding Timestamp, StringFormat={}{0:g}}"
                                            Header="时间" />
                            <GridViewColumn Width="90"
                                            DisplayMemberBinding="{Binding Status}"
                                            Header="状态" />
                            <GridViewColumn Width="90"
                                            DisplayMemberBinding="{Binding Confidence, StringFormat={}{0:0.00}}"
                                            Header="置信度" />
                            <GridViewColumn Width="260"
                                            DisplayMemberBinding="{Binding Reason}"
                                            Header="原因" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</Window>
