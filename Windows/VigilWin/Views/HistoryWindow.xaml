<Window x:Class="VigilWin.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        Width="1120"
        Height="740"
        MinWidth="960"
        MinHeight="640"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource AppBackgroundStart}" Offset="0" />
            <GradientStop Color="#EEF2F8" Offset="0.55" />
            <GradientStop Color="{StaticResource AppBackgroundEnd}" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid x:Name="HistoryShell"
          Margin="26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="RecentSessionsCard"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,22">
                    <TextBlock Style="{StaticResource SectionTitleText}"
                               Text="Recent Sessions" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Your latest 20 focus sessions." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListBox x:Name="SessionListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             FocusVisualStyle="{x:Null}"
                             SelectionChanged="SessionListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="SelectionChrome"
                                                    Padding="2"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="20">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SelectionChrome" Property="Background" Value="#60FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionChrome" Property="Background" Value="#ECEBFF" />
                                                    <Setter TargetName="SelectionChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource HistoryItemCard}">
                                    <StackPanel>
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding Goal}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource CaptionText}"
                                                   Text="{Binding StartTime, StringFormat=Started {0:g}}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource CaptionText}"
                                                   Text="{Binding DistractionCount, StringFormat=Distractions {0}}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   MaxHeight="42"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding Summary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptySessionsText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="No sessions yet. Start one from the main window."
                               TextAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="SessionDetailsCard"
                Grid.Column="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,22">
                    <TextBlock Style="{StaticResource SectionTitleText}"
                               Text="Session Details" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Review focus distribution, summary, and frame records." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyDetailsText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Start a focus session to see details here."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <Grid x:Name="DetailsContentPanel"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="18"
                                Background="#F7F9FD"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <StackPanel>
                                <TextBlock x:Name="DetailGoalText"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailStatsText"
                                           Margin="0,12,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1"
                              Margin="0,16,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource InnerMetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Focused" />
                                    <TextBlock x:Name="FocusedSecondsText" Style="{StaticResource MetricNumberText}" FontSize="26" Margin="0,7,0,0" Text="0s" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource InnerMetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Wandering" />
                                    <TextBlock x:Name="WanderingSecondsText" Style="{StaticResource MetricNumberText}" FontSize="26" Margin="0,7,0,0" Text="0s" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource InnerMetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Distracted" />
                                    <TextBlock x:Name="DistractedSecondsText" Style="{StaticResource MetricNumberText}" FontSize="26" Margin="0,7,0,0" Text="0s" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource InnerMetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Idle" />
                                    <TextBlock x:Name="IdleSecondsText" Style="{StaticResource MetricNumberText}" FontSize="26" Margin="0,7,0,0" Text="0s" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Margin="0,0,0,16"
                                Padding="18"
                                Background="#F7F9FD"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="Summary" />
                                <TextBlock x:Name="DetailSummaryText"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ListView x:Name="FrameRecordsListView"
                                  Grid.Row="3"
                                  Background="#F9FAFD"
                                  BorderBrush="{StaticResource BorderSoftBrush}"
                                  BorderThickness="1"
                                  FocusVisualStyle="{x:Null}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="145"
                                                    DisplayMemberBinding="{Binding Timestamp, StringFormat={}{0:g}}"
                                                    Header="Time" />
                                    <GridViewColumn Width="105"
                                                    DisplayMemberBinding="{Binding Status}"
                                                    Header="Status" />
                                    <GridViewColumn Width="105"
                                                    DisplayMemberBinding="{Binding Confidence, StringFormat={}{0:0.00}}"
                                                    Header="Confidence" />
                                    <GridViewColumn Width="300"
                                                    DisplayMemberBinding="{Binding Reason}"
                                                    Header="Reason" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
