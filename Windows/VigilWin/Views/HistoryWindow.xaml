<Window x:Class="VigilWin.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        Width="1040"
        Height="680"
        MinWidth="900"
        MinHeight="560"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7F8FC" Offset="0" />
            <GradientStop Color="#EEF2F8" Offset="0.55" />
            <GradientStop Color="#F6F3FF" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                               Text="Recent Sessions" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Your latest 20 focus sessions." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListBox x:Name="SessionListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="SessionListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16"
                                        Background="#F7F8FC"
                                        BorderBrush="#E4E8F0"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <StackPanel>
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding Goal}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding StartTime, StringFormat=Started {0:g}}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding DistractionCount, StringFormat=Distractions {0}}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   MaxHeight="42"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding Summary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptySessionsText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="No sessions yet"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                               Text="Session Details" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Review focus ratios, summary, and frame records." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyDetailsText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Start a focus session to see details here."
                               TextWrapping="Wrap" />

                    <DockPanel x:Name="DetailsContentPanel"
                               Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top"
                                    Margin="0,0,0,18">
                            <TextBlock x:Name="DetailGoalText"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailStatsText"
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,18,0,0"
                                    Padding="16"
                                    Background="#F7F8FC"
                                    BorderBrush="#E4E8F0"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Summary" />
                                    <TextBlock x:Name="DetailSummaryText"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ListView x:Name="FrameRecordsListView"
                                  BorderBrush="#E4E8F0"
                                  BorderThickness="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="145"
                                                    DisplayMemberBinding="{Binding Timestamp, StringFormat={}{0:g}}"
                                                    Header="Time" />
                                    <GridViewColumn Width="105"
                                                    DisplayMemberBinding="{Binding Status}"
                                                    Header="Status" />
                                    <GridViewColumn Width="105"
                                                    DisplayMemberBinding="{Binding Confidence, StringFormat={}{0:0.00}}"
                                                    Header="Confidence" />
                                    <GridViewColumn Width="300"
                                                    DisplayMemberBinding="{Binding Reason}"
                                                    Header="Reason" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
