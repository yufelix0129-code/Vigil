<Window x:Class="VigilWin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="760"
        Height="680"
        MinWidth="680"
        MinHeight="560"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7F8FC" Offset="0" />
            <GradientStop Color="#EEF2F8" Offset="0.55" />
            <GradientStop Color="#F6F3FF" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,0,4,22">
            <TextBlock FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Settings" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Configure your AI provider and focus monitor behavior." />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Margin="0,0,0,18"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,22">
                            <Button DockPanel.Dock="Right"
                                    Width="116"
                                    Style="{StaticResource PillButtonStyle}"
                                    Click="TestButton_Click"
                                    Content="Test Config" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                           Text="AI Provider" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="OpenAI-compatible vision endpoint. API Key is DPAPI-protected." />
                            </StackPanel>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Provider Name" />
                                <TextBox x:Name="ProviderNameTextBox"
                                         Style="{StaticResource RoundedTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Model" />
                                <TextBox x:Name="ModelTextBox"
                                         Style="{StaticResource RoundedTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Base URL" />
                                <TextBox x:Name="BaseUrlTextBox"
                                         Style="{StaticResource RoundedTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="API Key" />
                                <PasswordBox x:Name="ApiKeyPasswordBox"
                                             Style="{StaticResource RoundedPasswordBoxStyle}" />
                                <TextBlock x:Name="ApiKeyStatusText"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                   Text="Focus Monitor" />
                        <TextBlock Margin="0,5,0,22"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Tune how often Vigil captures your screen and when it treats you as idle." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Capture Interval Seconds" />
                                <TextBox x:Name="CaptureIntervalTextBox"
                                         Style="{StaticResource RoundedTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Idle Threshold Seconds" />
                                <TextBox x:Name="IdleThresholdTextBox"
                                         Style="{StaticResource RoundedTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal">
                                <CheckBox x:Name="EnableOverlayCheckBox"
                                          Margin="0,0,28,0"
                                          VerticalAlignment="Center"
                                          Content="Enable Overlay" />
                                <CheckBox x:Name="SaveScreenshotsCheckBox"
                                          VerticalAlignment="Center"
                                          Content="Save Screenshots" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2"
                   LastChildFill="False"
                   Margin="0,22,0,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Settings are stored locally under %APPDATA%/VigilWin." />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button Width="110"
                        Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"
                        Content="Cancel" />
                <Button Width="110"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click"
                        Content="Save" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
