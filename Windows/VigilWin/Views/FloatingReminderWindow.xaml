<Window x:Class="VigilWin.Views.FloatingReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        Height="154"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Border x:Name="ReminderShell"
            Margin="10"
            Padding="22"
            Background="#F2181A20"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              Direction="270"
                              Opacity="0.28"
                              ShadowDepth="8"
                              Color="#111827" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="124" />
            </Grid.ColumnDefinitions>

            <Border Height="1"
                    Margin="18,0,18,0"
                    VerticalAlignment="Top"
                    Background="#20FFFFFF"
                    CornerRadius="1" />

            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource IslandTextPrimaryBrush}"
                           Text="You may be off track" />
                <TextBlock x:Name="GoalText"
                           Margin="0,9,0,4"
                           Foreground="{StaticResource IslandTextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ReasonText"
                           Foreground="{StaticResource IslandTextSecondaryBrush}"
                           MaxHeight="38"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1"
                    Width="112"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource IslandButtonStyle}"
                    Click="CloseButton_Click"
                    Content="Back to Focus" />
        </Grid>
    </Border>
</Window>
