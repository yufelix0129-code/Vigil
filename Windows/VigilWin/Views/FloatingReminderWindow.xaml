<Window x:Class="VigilWin.Views.FloatingReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        Height="176"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None">
    <Border Margin="10"
            Padding="22"
            Background="#EE1F2937"
            BorderBrush="#35FFFFFF"
            BorderThickness="1"
            CornerRadius="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              Opacity="0.35"
                              ShadowDepth="10"
                              Color="#111827" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="128" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="You may be off track" />
                <TextBlock x:Name="GoalText"
                           Margin="0,10,0,4"
                           Foreground="#DDE7F3"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ReasonText"
                           Foreground="#AEBBCC"
                           MaxHeight="42"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1"
                    Width="116"
                    Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CloseButton_Click"
                    Content="Back to Focus" />
        </Grid>
    </Border>
</Window>
