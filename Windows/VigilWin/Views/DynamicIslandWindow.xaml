<Window x:Class="VigilWin.Views.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VigilWin.Views"
        Width="360"
        Height="78"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Opacity="0"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Border x:Name="IslandRoot"
            Margin="7"
            Padding="0"
            Background="{StaticResource IslandBackgroundBrush}"
            BorderBrush="{StaticResource IslandBorderBrush}"
            BorderThickness="1"
            CornerRadius="39"
            MouseEnter="IslandRoot_MouseEnter"
            MouseLeave="IslandRoot_MouseLeave"
            MouseLeftButtonUp="IslandRoot_MouseLeftButtonUp"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect x:Name="IslandShadow"
                              BlurRadius="32"
                              Direction="270"
                              Opacity="0.30"
                              ShadowDepth="0"
                              Color="#000000" />
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
            <ScaleTransform x:Name="IslandScale"
                                ScaleX="0.98"
                                ScaleY="0.98" />
                <TranslateTransform x:Name="IslandTranslate"
                                    Y="-6" />
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Border Height="1"
                    Margin="22,0,22,0"
                    VerticalAlignment="Top"
                    Background="{StaticResource IslandHighlightBrush}"
                    CornerRadius="1"
                    IsHitTestVisible="False" />

            <Grid x:Name="CompactContent"
                  Margin="18,8"
                  Opacity="1"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CompactContentScale"
                                        ScaleX="1"
                                        ScaleY="1" />
                        <TranslateTransform x:Name="CompactContentTranslate"
                                            Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="CompactStatusDot"
                                 Width="11"
                                 Height="11"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Fill="#8B93A3" />
                        <TextBlock x:Name="CompactGoalText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource IslandTextPrimaryBrush}"
                                   Text="Focus goal"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </Grid>

                    <TextBlock x:Name="CompactElapsedText"
                               Grid.Column="1"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas, Segoe UI"
                               FontSize="29"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="00:00" />
                </Grid>

                <views:FocusTimelineBar x:Name="CompactTimelineBar"
                                        Grid.Row="1"
                                        Height="2"
                                        Margin="2,5,2,0"
                                        IsMini="True" />
            </Grid>

            <Grid x:Name="ExpandedContent"
                  Margin="30,22,30,20"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ExpandedContentScale"
                                        ScaleX="0.985"
                                        ScaleY="0.985" />
                        <TranslateTransform x:Name="ExpandedContentTranslate"
                                            Y="8" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="ExpandedStatusDot"
                             Width="11"
                             Height="11"
                             Margin="0,0,11,0"
                             VerticalAlignment="Center"
                             Fill="#8B93A3" />
                    <TextBlock x:Name="ExpandedTitleText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IslandTextPrimaryBrush}"
                               Text="Focus goal"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock x:Name="ExpandedElapsedText"
                               Grid.Column="2"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="34"
                               FontWeight="SemiBold"
                               FontFamily="Cascadia Mono, Consolas, Segoe UI"
                               Foreground="White"
                               Text="00:00" />
                </Grid>

                <TextBlock x:Name="ReasonText"
                           Grid.Row="1"
                           Margin="0,12,0,8"
                           MaxHeight="48"
                           VerticalAlignment="Top"
                           FontSize="12"
                           Foreground="{StaticResource IslandTextSecondaryBrush}"
                           LineHeight="18"
                           Text="Waiting for first analysis..."
                           TextWrapping="Wrap" />

                <Grid x:Name="ExpandedTimelinePanel"
                      Grid.Row="2"
                      Margin="0,0,0,8"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ExpandedTimelineTranslate"
                                            Y="0" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,7">
                        <TextBlock x:Name="ProgressPercentText"
                                   DockPanel.Dock="Right"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#C8CFDC"
                                   Text="0%" />
                        <TextBlock x:Name="ProgressLabelText"
                                   FontSize="11"
                                   Foreground="#8892A6"
                                   Text="Focus progress" />
                    </DockPanel>
                    <views:FocusTimelineBar x:Name="ExpandedTimelineBar"
                                            Grid.Row="1"
                                            Height="14" />
                </Grid>

                <StackPanel x:Name="ActionButtonsPanel"
                            Grid.Row="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ActionButtonsTranslate"
                                            Y="0" />
                    </StackPanel.RenderTransform>
                    <Button Width="104"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource IslandButtonStyle}"
                            Click="BackToFocusButton_Click"
                            Content="Back to Focus"
                            FontSize="11" />
                    <Button Width="64"
                            Height="32"
                            Style="{StaticResource IslandGhostButtonStyle}"
                            Click="HideButton_Click"
                            Content="Hide"
                            FontSize="11" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
