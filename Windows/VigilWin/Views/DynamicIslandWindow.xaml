<Window x:Class="VigilWin.Views.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="76"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Border x:Name="IslandRoot"
            Margin="8"
            Padding="18,12"
            Background="#F21A1C22"
            BorderBrush="#28FFFFFF"
            BorderThickness="1"
            CornerRadius="38"
            MouseLeftButtonUp="IslandRoot_MouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              Direction="270"
                              Opacity="0.32"
                              ShadowDepth="0"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid x:Name="CompactPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="10"
                                 Height="10"
                                 Margin="0,0,9,0"
                                 VerticalAlignment="Center"
                                 Fill="#8B93A3" />
                        <TextBlock x:Name="StatusText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#F6F7FB"
                                   Text="Focused" />
                    </StackPanel>
                    <TextBlock x:Name="GoalText"
                               Width="178"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="#AEB4C2"
                               Text="Focus goal"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>

                <TextBlock x:Name="ElapsedText"
                           Grid.Column="1"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="00:00" />
            </Grid>

            <Grid x:Name="ExpandedPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock x:Name="ExpandedElapsedText"
                               DockPanel.Dock="Right"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="00:00" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ExpandedStatusDot"
                                 Width="11"
                                 Height="11"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Fill="#8B93A3" />
                        <TextBlock x:Name="ExpandedTitleText"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="Focus session started" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,14,0,12">
                    <TextBlock x:Name="ExpandedGoalText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E9ECF3"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ReasonText"
                               Margin="0,6,0,0"
                               MaxHeight="44"
                               FontSize="12"
                               Foreground="#AEB4C2"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Width="92"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BackToFocusButton_Click"
                            Content="Back to Focus"
                            FontSize="11" />
                    <Button Width="64"
                            Height="32"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="HideButton_Click"
                            Content="Hide"
                            FontSize="11" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
