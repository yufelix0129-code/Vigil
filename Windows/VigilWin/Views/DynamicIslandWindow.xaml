<Window x:Class="VigilWin.Views.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        Height="76"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Opacity="0"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Border x:Name="IslandRoot"
            Margin="8"
            Padding="18,12"
            Background="{StaticResource IslandBackgroundBrush}"
            BorderBrush="{StaticResource IslandBorderBrush}"
            BorderThickness="1"
            CornerRadius="38"
            MouseEnter="IslandRoot_MouseEnter"
            MouseLeave="IslandRoot_MouseLeave"
            MouseLeftButtonUp="IslandRoot_MouseLeftButtonUp"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect x:Name="IslandShadow"
                              BlurRadius="32"
                              Direction="270"
                              Opacity="0.30"
                              ShadowDepth="0"
                              Color="#000000" />
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
            <ScaleTransform x:Name="IslandScale"
                                ScaleX="0.98"
                                ScaleY="0.98" />
                <TranslateTransform x:Name="IslandTranslate"
                                    Y="-6" />
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Border Height="1"
                    Margin="22,0,22,0"
                    VerticalAlignment="Top"
                    Background="{StaticResource IslandHighlightBrush}"
                    CornerRadius="1"
                    IsHitTestVisible="False" />

            <Grid x:Name="CompactContent"
                  Opacity="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CompactStatusDot"
                                     Width="10"
                                     Height="10"
                                     Margin="0,0,9,0"
                                     VerticalAlignment="Center"
                                     Fill="#8B93A3" />
                            <TextBlock x:Name="CompactStatusText"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource IslandTextPrimaryBrush}"
                                       Text="Monitoring" />
                        </StackPanel>
                        <TextBlock x:Name="CompactGoalText"
                                   Width="192"
                                   Margin="0,5,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource IslandTextSecondaryBrush}"
                                   Text="Focus goal"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </StackPanel>

                    <TextBlock x:Name="CompactElapsedText"
                               Grid.Column="1"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas, Segoe UI"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="00:00" />
                </Grid>

                <ProgressBar x:Name="CompactProgressBar"
                             Grid.Row="1"
                             Height="2"
                             Margin="3,8,3,0"
                             Maximum="100"
                             Minimum="0"
                             Value="0"
                             Foreground="#35D3AE"
                             Background="{StaticResource IslandProgressTrackBrush}"
                             BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid ClipToBounds="True">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="1" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="1" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Grid>

            <Grid x:Name="ExpandedContent"
                  Opacity="0"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           LastChildFill="True">
                    <TextBlock x:Name="ExpandedElapsedText"
                               DockPanel.Dock="Right"
                               Margin="18,0,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               FontFamily="Cascadia Mono, Consolas, Segoe UI"
                               Foreground="White"
                               Text="00:00" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ExpandedStatusDot"
                                 Width="11"
                                 Height="11"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Fill="#8B93A3" />
                        <TextBlock x:Name="ExpandedTitleText"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource IslandTextPrimaryBrush}"
                                   Text="Focus session started"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,14,0,10">
                    <TextBlock x:Name="ExpandedGoalText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IslandTextPrimaryBrush}"
                               Text="Goal: Focus goal"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock x:Name="ReasonText"
                               Margin="0,7,0,0"
                               MaxHeight="48"
                               FontSize="12"
                               Foreground="{StaticResource IslandTextSecondaryBrush}"
                               LineHeight="17"
                               Text="Current status: Monitoring"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="2"
                      Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,7">
                        <TextBlock x:Name="ProgressPercentText"
                                   DockPanel.Dock="Right"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#C8CFDC"
                                   Text="0%" />
                        <TextBlock x:Name="ProgressLabelText"
                                   FontSize="11"
                                   Foreground="#8892A6"
                                   Text="Focus progress" />
                    </DockPanel>
                    <ProgressBar x:Name="SessionProgressBar"
                                 Grid.Row="1"
                                 Height="6"
                                 Maximum="100"
                                 Minimum="0"
                                 Value="0"
                                 Foreground="#35D3AE"
                                 Background="{StaticResource IslandProgressTrackBrush}"
                                 BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid ClipToBounds="True">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="3" />
                                    <Border x:Name="PART_Track"
                                            Background="Transparent"
                                            CornerRadius="3" />
                                    <Border x:Name="PART_Indicator"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="3" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Grid>

                <StackPanel x:Name="ActionButtonsPanel"
                            Grid.Row="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Width="104"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource IslandButtonStyle}"
                            Click="BackToFocusButton_Click"
                            Content="Back to Focus"
                            FontSize="11" />
                    <Button Width="64"
                            Height="32"
                            Style="{StaticResource IslandGhostButtonStyle}"
                            Click="HideButton_Click"
                            Content="Hide"
                            FontSize="11" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
